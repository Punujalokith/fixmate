# Copy this file to .env and adjust values.
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
CORS_ORIGINS=*

# Matches docker-compose.yml
DATABASE_URL="postgresql://fixmate:fixmate_dev_password@localhost:5433/fixmate?schema=public"
REDIS_URL="redis://localhost:6380"

# Auth - generate a long random secret, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Bookings
BOOKING_ACCEPT_TIMEOUT_MINUTES=30
BOOKING_MIN_LEAD_MINUTES=60
BOOKING_LATE_CANCEL_HOURS=2
BUSINESS_TIMEZONE=Asia/Colombo

# Files
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# Optional - leave empty to use built-in fallbacks
# AI assistant: https://console.anthropic.com -> API keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
# Push notifications: Firebase console -> Project settings -> Service accounts -> Generate key
FIREBASE_SERVICE_ACCOUNT_PATH=

# Rate limits (requests per minute)
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10
