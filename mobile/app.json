{
  "expo": {
    "name": "FixMate",
    "slug": "fixmate",
    "scheme": "fixmate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "lk.fixmate.app"
    },
    "android": {
      "package": "lk.fixmate.app",
      "adaptiveIcon": {
        "backgroundColor": "#0F766E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-image",
      "expo-font",
      [
        "expo-image-picker",
        { "photosPermission": "FixMate uses your photos so you can show providers the problem." }
      ],
      [
        "expo-notifications",
        { "color": "#0F766E" }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
